version: '3.8'

services:
  app:
    container_name: {{ app_container_name }}
    build:
      context: .
      dockerfile: Dockerfile
    restart: always
    ports:
      - "{{ app_environment_port }}:3000"
    environment:
      - NODE_ENV={{ environment }}
      - PORT=3000
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:3000/health"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
