#!/bin/bash
set -euo pipefail

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="{{ backup_dir }}"
S3_BUCKET="{{ backup_s3_bucket }}"
TARBALL="$BACKUP_DIR/app_backup_$TIMESTAMP.tar.gz"

mkdir -p "$BACKUP_DIR"

echo "[INFO] Starting application data backup at $TIMESTAMP..."

# Archive application & monitoring config files
tar -czf "$TARBALL" -C /opt app monitoring 2>/dev/null || true

echo "[INFO] Syncing backup archive to S3 bucket: s3://$S3_BUCKET/backups/"
aws s3 cp "$TARBALL" "s3://$S3_BUCKET/backups/app_backup_$TIMESTAMP.tar.gz" --only-show-errors || true

# Keep local retention to 7 days
find "$BACKUP_DIR" -type f -name "*.tar.gz" -mtime +7 -delete

echo "[INFO] Backup completed successfully."
